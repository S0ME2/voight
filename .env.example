# Select exactly one Compose profile: cpu for local work, gpu only on the V100 server.
COMPOSE_PROFILES=cpu
RUNTIME_TARGET=cpu
GPU_ID=0
VOIGHT_PORT=8000
MODEL_DIR=/home/voight/.paddlex
PRELOAD=false
LOGGING=true
LOG_DIR=logs
CPU_THREADS=4
REQUEST_QUEUE_LIMIT=8
LOCALIZATION_BATCH_SIZE=16
TEXT_DETECTION_BATCH_SIZE=16
TEXT_RECOGNITION_BATCH_SIZE=32
MRZ_RECOGNITION_BATCH_SIZE=16
TEXT_RECOGNITION_PROCESSES=1
TEXT_RECOGNITION_ENABLE_HPI=false
TEXT_RECOGNITION_USE_TENSORRT=false
TEXT_RECOGNITION_PRECISION=fp32
TEXT_RECOGNITION_PACKING=sequential
TEXT_DETECTOR_BACKEND=paddle
TEXT_DETECTOR_MODEL=PP-OCRv6_medium_det
TEXT_RECOGNIZER_BACKEND=paddle
TEXT_RECOGNIZER_MODEL=PP-OCRv6_medium_rec
DOCUMENT_LOCALIZER_BACKEND=docaligner
MRZ_LOCALIZER_BACKEND=mrzscanner
MRZ_RECOGNIZER_BACKEND=generic-paddle
MRZ_RECOGNIZER_MODEL=20250221
BATCH_MAX_FILES=16
BATCH_MAX_FILE_BYTES=52428800
BATCH_MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
