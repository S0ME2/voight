# Application
# Host port exposed by Docker Compose (optional).
VOIGHT_PORT=8000
# Load all required models during process startup instead of first readiness/use.
PRELOAD=false

# Runtime
# Required: cpu locally; gpu only in the GPU image on the V100 server.
RUNTIME_TARGET=cpu
# CPU-only: total inference threads available to this process.
CPU_THREADS=4
OMP_NUM_THREADS=1
# GPU-only: zero-based NVIDIA device index.
GPU_ID=0
# Deprecated: OCR_DEVICE follows RUNTIME_TARGET and should normally be unset.
# OCR_DEVICE=cpu

# Models
# Image-managed model root. Do not replace this with a host path unless mounting it.
MODEL_DIR=/opt/voight/models
TEXT_DETECTOR_BACKEND=paddle
TEXT_DETECTOR_MODEL=PP-OCRv6_medium_det
# Optional detector preprocessing overrides, validated through RuntimeSettings.
TEXT_DETECTOR_PIXEL_SCALE=1
# Benchmarkable preprocessing variants; defaults preserve production behavior.
TEXT_DETECTOR_PREPROCESSING=original
VISIBLE_RECOGNITION_PREPROCESSING=original
MRZ_PREPROCESSING=contrast_1.50
# TEXT_DETECTOR_LIMIT_SIDE_LEN=960
TEXT_RECOGNIZER_BACKEND=paddle
TEXT_RECOGNIZER_MODEL=latin_PP-OCRv5_mobile_rec
DOCUMENT_LOCALIZER_BACKEND=docaligner
DOCALIGNER_MODEL=fastvit_sa24
DOCALIGNER_MODEL_TYPE=heatmap
MRZ_LOCALIZER_BACKEND=mrzscanner
MRZSCANNER_DETECTION_CFG=20250222
# generic-paddle is the maintained default; mrzscanner is experimental.
MRZ_RECOGNIZER_BACKEND=generic-paddle
MRZ_RECOGNIZER_MODEL=20250221

# Batching and admission
# Includes the active request; excess requests receive HTTP 503.
REQUEST_QUEUE_LIMIT=8
LOCALIZATION_BATCH_SIZE=4
TEXT_DETECTION_BATCH_SIZE=1
TEXT_RECOGNITION_BATCH_SIZE=2
MRZ_RECOGNITION_BATCH_SIZE=2
# CPU-only process parallelism. Keep 1 unless measurements justify more.
TEXT_RECOGNITION_PROCESSES=1
# fixed-width keeps each crop's model input independent of unrelated crops.
TEXT_RECOGNITION_PACKING=fixed-width

# Recognition acceleration (GPU-only, experimental, disabled by default)
TEXT_RECOGNITION_ENABLE_HPI=false
TEXT_RECOGNITION_USE_TENSORRT=false
TEXT_RECOGNITION_PRECISION=fp32

# MRZ and document geometry
OCR_MAX_SIDE=3000
OCR_CONTRAST=1.50
MRZ_POLYGON_PADDING_RATIO=0.03
DOCALIGNER_PADDING=100
DRIVING_LICENSE_CANONICAL_WIDTH=1000
DRIVING_LICENSE_CANONICAL_HEIGHT=630
DRIVING_LICENSE_MIN_OVERLAP_RATIO=0.30
# Optional profile path overrides; project defaults are normally correct.
# PASSPORT_PROFILE=config/documents/uz_passport/profile.json
# ID_CARD_PROFILE=config/documents/uz_id_card/profile.json
# DRIVING_LICENSE_DATA_CROP=config/driving_license/data_crop.json
# DRIVING_LICENSE_FIELD_ROIS=config/driving_license/field_rois_crop.json

# Logging and generated artifacts
LOGGING=true
LOG_DIR=logs

# API upload limits
BATCH_MAX_FILES=16
BATCH_MAX_FILE_BYTES=52428800
BATCH_MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
